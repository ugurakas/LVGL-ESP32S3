/* Reference wiring only: ESP32-S3-DevKitC + 128x128 ST7735R.
 * Confirm the controller and wiring on your module before using this overlay.
 * SPI: SCK=12 MOSI=11 CS=10 DC=9 RESET=8. Backlight: external 3.3 V.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>
/ {
    chosen {
        zephyr,display = &panel;
    };
};
&pinctrl {
    panel_spi: panel_spi {
        group1 {
            pinmux = <SPIM2_SCLK_GPIO12>, <SPIM2_MOSI_GPIO11>;
        };
    };
};
&spi2 {
    status = "okay";
    pinctrl-0 = <&panel_spi>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
    panel: st7735r@0 {
        compatible = "sitronix,st7735r";
        reg = <0>;
        spi-max-frequency = <20000000>;
        cmd-data-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
        width = <128>;
        height = <128>;
        x-offset = <2>;
        y-offset = <3>;
        madctl = <0xc8>;
        colmod = <0x05>;
        frmctr1 = [01 2c 2d];
        frmctr2 = [01 2c 2d];
        frmctr3 = [01 2c 2d 01 2c 2d];
        invctr = <0x07>;
        pwctr1 = [a2 02 84];
        pwctr2 = [c5];
        pwctr3 = [0a 00];
        pwctr4 = [8a 2a];
        pwctr5 = [8a ee];
        vmctr1 = <0x0e>;
        gamctrp1 = [02 1c 07 12 37 32 29 2d 29 25 2b 39 00 01 03 10];
        gamctrn1 = [03 1d 07 06 2e 2c 29 2d 2e 2e 37 3f 00 00 02 10];
    };
};
&wifi {
    status = "okay";
};
